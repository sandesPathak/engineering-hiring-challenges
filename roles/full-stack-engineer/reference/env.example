# Copy this into the root of YOUR repository as `.env.example`, adjust it to your stack,
# and commit that. Never commit a real `.env`.
#
# Every value below is a placeholder. `docker compose up` must work with these as they are.

# ---- Database -------------------------------------------------------------
POSTGRES_USER=aangan
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=aangan
# Inside the compose network the host is the service name, not localhost.
DATABASE_URL=postgres://aangan:change_me_locally@db:5432/aangan

# ---- API ------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# openssl rand -hex 32
SESSION_SECRET=replace_me_with_32_random_bytes
SESSION_TTL_HOURS=24
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ---- Payments -------------------------------------------------------------
# The mock provider. There is no real key and there must not be one.
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_LATENCY_MS=250
PAYMENT_TIMEOUT_MS=8000

# ---- Business rules -------------------------------------------------------
# Both enforced server-side. The client-side check is a convenience, not the control.
DONATION_MIN_CENTS=100
DONATION_MAX_CENTS=2500000
# "Today" is defined in the organisation's timezone, in exactly one place. This is it.
ORG_TIMEZONE=America/Chicago

# ---- Web ------------------------------------------------------------------
# The browser resolves this, not the container — so localhost, not http://api:4000.
NEXT_PUBLIC_API_URL=http://localhost:4000
